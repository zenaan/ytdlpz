#________________________________________
# may be add 'x' to the inclusion char set for m--b/* ??

# protip: how to test remainder files BEFORE piping to media player!:
# vids|egrep -iv 'mp4$|mkv$|webm$|mpe?g$|wmv$|avi$|3gp$|flv$|mov$|rm$|m4v$'
# note: readarray and mapfile are synonyms in bash

SORT=no

get_args () {
	case "$1" in
		-s) SORT=yes ; shift ;;
	esac
	for i in "$@"; do
		readarray -d '' -O ${#files[@]} files < <(find "$i" -type f -print0 | egrep -zi '[.]..[viVI4a]$|wmf$|mpe?g$|webm$|3gp$|rm$' | egrep -ziv 'csv$|sfv$|wav$|ini$')
	done
}

# convert the filenames into a format safe for using on the command line/ in a pipe:
normalize_filenames () { IFS=$'\n' files=($(printf '%q\n' "${files[@]}")) ; }

# optionally sort:
apply_sort () {
	case $SORT in
		yes)
			#echo sorting __
			files=($(printf '%s\n' "${files[@]}" | sort))
			# may need to swap the above line (files=...) with the following (readarray...) to handle spaces in filenames, but may work given we already normalize filenames
			#readarray -t files < <(printf "%s\n" "${files[@]}" | sort)
		;;
	esac
}

get_args "$@"
normalize_filenames
#echo; printf '%s\n' "${files[@]}"; echo ${#files[@]}
apply_sort

printf '%s\n' "${files[@]}"

